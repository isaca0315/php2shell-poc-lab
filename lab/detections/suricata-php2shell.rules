# Reglas Suricata de laboratorio para PHP2Shell.
# Ajustar `$HOME_NET` y el puerto si el frontend no escucha en 80.
# No son reglas de produccion: priorizan visibilidad sobre precision.

alert http $EXTERNAL_NET any -> $HOME_NET 80 ( \
  msg:"PHP2Shell - POST multipart con PHP_SESSION_UPLOAD_PROGRESS"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; \
  http.request_body; content:"PHPSESSID"; nocase; \
  classtype:web-application-attack; \
  metadata:affected_product PHP, attack_target Web_Server, deployment Perimeter; \
  sid:2026109618; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET 80 ( \
  msg:"PHP2Shell - valor de progreso anormalmente grande"; \
  flow:established,to_server; \
  http.method; content:"POST"; \
  http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; \
  http.request_body; content:"|41 41 41 41 41 41 41 41 41 41 41 41 41 41 41 41|"; \
  dsize:>65536; \
  classtype:attempted-dos; \
  metadata:affected_product PHP, attack_target Web_Server, deployment Perimeter; \
  sid:2026109619; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"PHP2Shell - respuesta 502 tras POST FastCGI"; \
  flow:established,from_server; \
  http.stat_code; content:"502"; \
  http.header; content:"Server|3a| nginx"; nocase; \
  classtype:protocol-command-decode; \
  sid:2026109620; rev:1;)
